# Kanshi configuration for Hyprland
# Place this file at: ~/.config/kanshi/config

# Profile for laptop only (undocked)
profile laptop {
    output eDP-1 enable mode 1920x1200@60Hz position 0,0 scale 1.25
}

# Profile for laptop + external monitor via DisplayPort
profile docked {
    output eDP-1 disable
    output DP-1 enable mode 2560x1440@144Hz position 0,0 scale 1.25
}

profile docked-full {
    output eDP-1 enable mode 1920x1200@60Hz position 0,0 scale 1.5
    output DP-1 enable mode 2560x1440@144Hz position 1280,0 scale 1.25
}
