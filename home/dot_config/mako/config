# Mako configuration - Maple Mono + Ayu Dark theme

# Font
font=SF Pro Rounded 11

# Dimensions
width=350
height=150
margin=10
padding=15

# Position
anchor=top-right

# Colors - Ayu Dark theme
background-color=#0d1017e6
text-color=#bfbdb6
border-color=#39bae6
border-size=2
border-radius=8

# Progress bar
progress-color=over #7fd962

# Icons
icon-path=/usr/share/icons/hicolor
max-icon-size=48

# Behavior
default-timeout=5000
ignore-timeout=0

# Grouping
group-by=app-name
max-visible=5

# Urgency: Low
[urgency=low]
background-color=#0d1017e6
text-color=#bfbdb6
border-color=#7fd962
default-timeout=3000

# Urgency: Normal
[urgency=normal]
background-color=#0d1017e6
text-color=#bfbdb6
border-color=#39bae6
default-timeout=5000

# Urgency: Critical
[urgency=critical]
background-color=#0d1017e6
text-color=#bfbdb6
border-color=#f07178
border-size=3
default-timeout=0
ignore-timeout=1

# Application specific
[app-name="Spotify"]
border-color=#e6b450

[app-name="Discord"]
border-color=#d2a6ff

[app-name="Volume"]
border-color=#d2a6ff

[app-name="Brightness"]
border-color=#e6b450
